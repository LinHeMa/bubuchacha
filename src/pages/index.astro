import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>🧑‍🚀 Hello, Friends!</h1>
      <p>
        Welcome to the official <a href="https://astro.build/">LinHeMa's</a> blog
      </p>
      <p>There are a lot of things I would like to document.</p>
      <p>Nice meeting you!</p>
    </main>
    <Footer />
  </body>
</html>
